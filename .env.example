# LIONS OF ZION — backend environment
#
# Names only. No values, ever. Copy to .env.local and fill in.
# Nothing here is required to run the test suite: it runs against an in-process
# PGlite database with no configuration at all.

# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres, via the Vercel integration.
# Must be the pooled (-pooler) connection string: the app uses the WebSocket
# driver, which needs interactive transactions for identity-scoped queries.
# DATABASE_URL=
# DATABASE_POOL_MAX=
# DATABASE_POOL_IDLE_TIMEOUT_MS=
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=

# Integration tests that need pgvector run against a real Postgres, because
# PGlite does not ship the extension. Leave unset to skip those tests.
# TEST_DATABASE_URL=

# ── Storage ─────────────────────────────────────────────────────────────────
# Vercel Blob. Keep news-ingestion storage separate from the October 7 archive.
# Raw news captures are private and use only the briefing/raw prefix.
# BLOB_READ_WRITE_TOKEN=
# Dedicated private briefing store token (preferred in deployed briefing envs).
# BRIEFING_BLOB_READ_WRITE_TOKEN=

# ── AI ──────────────────────────────────────────────────────────────────────
# Vercel AI Gateway.
# The application asks for a model PROFILE (fast/reasoning/embedding/...), never
# a provider model id; the mapping lives in server/core/config.ts.
# Production uses the short-lived VERCEL_OIDC_TOKEN supplied by Vercel. A
# static AI_GATEWAY_API_KEY may be used locally only.
# AI_GATEWAY_API_KEY=
# xAI API key for the public chat and Grok's live X search tool.
# XAI_API_KEY=

# Google Agent Search is discovery-only. Production authenticates with
# short-lived Application Default Credentials through Workload Identity
# Federation; do not store a service-account JSON key here. A local credential
# is obtained through the authenticated gcloud session, not copied into this
# file. The legacy Google grounding key is intentionally absent.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# GOOGLE_AGENT_SEARCH_ENGINE_ID=
# GOOGLE_AGENT_SEARCH_SERVING_CONFIG=
# GOOGLE_WORKLOAD_IDENTITY_PROVIDER=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SEARCH_MONTHLY_LIMIT=
# GOOGLE_SEARCH_MONTHLY_BUDGET_USD=
# GOOGLE_SEARCH_ESTIMATED_COST_PER_QUERY_USD=
# BRIEFING_RAW_STORAGE_WARNING_BYTES=
# BRIEFING_AI_DAILY_BUDGET_USD=
# BRIEFING_AI_MONTHLY_BUDGET_USD=
# BRIEFING_COLLECTION_ENABLED=
# BRIEFING_PROCESSING_ENABLED=
# BRIEFING_AUTO_PUBLISH_ENABLED=
# Optional canary controls. Empty means all active sources / all editorial stages.
# BRIEFING_COLLECTION_SOURCE_IDS=
# BRIEFING_ENABLED_STAGES=
# BRIEFING_QUEUE_REGION=
# BRIEFING_QUEUE_RESOURCE_ID=
# DATABASE_RESOURCE_ENV=
# BLOB_RESOURCE_ENV=
# QUEUE_RESOURCE_ENV=
# SEARCH_RESOURCE_ENV=
# BRIEFING_BLOB_RESOURCE_ID=
# OCTOBER7_BLOB_RESOURCE_ID=

# Budget ceilings. Crossing one refuses the next model call and logs a
# rate-limit event; it never silently changes profile or keeps spending.
# AI_DAILY_BUDGET_USD=
# AI_MONTHLY_BUDGET_USD=

# ── Authentication ─────────────────────────────────────────────────────────
# Neon Auth is enabled on the same Neon project. Only ADMIN_EMAIL may sign up
# or enter /admin. The cookie secret must contain at least 32 random characters.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=
# ADMIN_EMAIL=

# HMAC key for anonymous IP-derived rate-limit buckets (never stores raw IPs).
# RATE_LIMIT_HMAC_SECRET=

# Canonical public origin. Defaults to https://lionsofzion.io.
# NEXT_PUBLIC_SITE_URL=

# Google Identity Services public web client ID. This is intentionally public;
# keep the OAuth client secret only in Google Cloud and never in Vercel.
# NEXT_PUBLIC_GOOGLE_IDENTITY_CLIENT_ID=
# GOOGLE_AUTH_SESSION_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Google Workspace SMTP. Use the primary admin account and a Google app
# password; never use the normal account password and never commit either.
# GOOGLE_WORKSPACE_SMTP_USER=
# GOOGLE_WORKSPACE_SMTP_APP_PASSWORD=

# ── Ingestion ───────────────────────────────────────────────────────────────
# Vercel Queues authenticates via OIDC (`vercel link`,
# `vercel env pull`), not an env var set here. Its absence is not fatal: the
# outbox drain cron dispatches straight to it and simply retries on the next
# tick if it is unreachable, so ingestion works with only DATABASE_URL and
# BLOB_READ_WRITE_TOKEN configured.

# ── Runtime ─────────────────────────────────────────────────────────────────
# Guards internal cron/queue/workflow routes. Vercel sends its own header for
# cron; this covers everything else.
# INTERNAL_API_SECRET=
# Dedicated bearer secret for scheduled Codex briefing imports.
# CODEX_BRIEFING_IMPORT_SECRET=

# Signs Vercel Cron's own requests: Vercel sends `Authorization: Bearer
# $CRON_SECRET` automatically once this is set, with nothing else to wire up.
# CRON_SECRET=

# development | preview | production. Preview must never publish, never run
# production crons, never mutate production storage.
# APP_ENV=
