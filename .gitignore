# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local visual-verification output
/screenshots
/.screenshots

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Archive assets: dev-only symlinks to the integration packages.
# Media never enters git (~1.8 GB); production serves it from a CDN.
# Created by: scripts/import-archive-package.mjs --link-assets
public/archive/

# Upload progress for scripts/upload-archive-assets.mjs (resume state, local only)
.blob-upload/

# Agent worktrees (were excluded only via .git/info/exclude, which is per-clone).
# Root-anchored /node_modules and /.next do NOT match .claude/worktrees/<n>/node_modules.
.claude/worktrees/

# Local cost/infra scratch export. Duplicates the table in
# docs/vercel-infrastructure.md; kept out of a public repository.
/vercel-infrastructure-costs.html
