{
  "name": "lions-of-zion",
  "version": "0.1.0",
  "private": true,
  "//sideEffects": "Every module under components/motion imports a CSS Module, which is a side effect, so without this a bundler must assume importing the barrel needs all six stylesheets — and a route rendering one primitive shipped five it never used. Listing CSS as the only side effect lets the barrel be tree-shaken while keeping stylesheets from being dropped.",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "bake:nav-lion": "tsx scripts/particle-nav/bake/bake-lion-reference.ts",
    "bake:nav-icons": "tsx scripts/particle-nav/bake/bake-icons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "briefing:smoke": "bash scripts/verify-briefing-public.sh",
    "db:import-public": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-public-content.ts",
    "db:studio": "drizzle-kit studio",
    "briefing:sources:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-briefing-sources.ts",
    "briefing:sources:verify": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-briefing-sources.ts",
    "briefing:sources:connectivity": "tsx scripts/check-briefing-feed-connectivity.ts",
    "briefing:backup": "bash scripts/backup-briefing-database.sh",
    "briefing:restore:verify": "bash scripts/verify-briefing-restore.sh",
    "briefing:migrate:preflight": "bash scripts/briefing-migrate-preflight.sh",
    "briefing:predeploy": "bash scripts/briefing-predeploy.sh",
    "briefing:db-pressure": "tsx scripts/measure-briefing-db-pressure.ts",
    "briefing:archive:defective": "NODE_OPTIONS=--conditions=react-server tsx scripts/archive-defective-briefing-publications.ts",
    "briefing:retention:dry-run": "NODE_OPTIONS=--conditions=react-server tsx scripts/prune-briefing-raw-blobs.ts",
    "briefing:retention:apply": "NODE_OPTIONS=--conditions=react-server tsx scripts/prune-briefing-raw-blobs.ts --apply",
    "briefing:smoke:production": "node scripts/verify-briefing-production.mjs",
    "dev": "next dev",
    "lint": "eslint",
    "map": "node scripts/project-map.mjs",
    "map:check": "node scripts/project-map.mjs --check",
    "poster:nav": "tsx scripts/particle-nav/make-poster.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "main:update": "node scripts/startup-sync.mjs --publish",
    "sync:start": "node scripts/startup-sync.mjs",
    "verify:changed": "tsx scripts/verify-changed.ts",
    "verify:full": "npm run typecheck && npm run lint && npm test && npm run build && npm run map:check",
    "verify:graphics": "node scripts/verify-composition.mjs"
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.128",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/oidc": "^3.8.5",
    "@vercel/queue": "^0.5.0",
    "ai": "^6.0.264",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "^0.555.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "leva": "0.10.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
