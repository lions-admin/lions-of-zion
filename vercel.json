{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "briefing-packages": false,
      "editorial-packages": false
    }
  },
  "functions": {
    "app/api/internal/briefing/external-publish/route.ts": {
      "maxDuration": 300,
      "regions": ["iad1"]
    },
    "app/api/internal/queue/ingest/route.ts": {
      "maxDuration": 300,
      "regions": ["iad1"],
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "source-ingest", "retryAfterSeconds": 30 }]
    },
    "app/api/internal/queue/outbox-dispatch/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "outbox.dispatch" }]
    }
  },
  "crons": [
    { "path": "/api/internal/cron/ingest", "schedule": "0,30 * * * *" },
    { "path": "/api/internal/cron/embed", "schedule": "10,40 * * * *" },
    { "path": "/api/internal/cron/outbox-drain", "schedule": "*/15 * * * *" },
    { "path": "/api/internal/cron/maintenance", "schedule": "20 3 * * *" }
  ]
}
