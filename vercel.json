{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "briefing-packages": false,
      "editorial-updates": false,
      "chatgpt-editorial-updates": false
    }
  },
  "functions": {
    "app/api/internal/briefing/external-publish/route.ts": {
      "maxDuration": 300,
      "regions": ["iad1"]
    },
    "app/api/internal/queue/ingest/route.ts": {
      "maxDuration": 300,
      "regions": ["iad1"],
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "source-ingest", "retryAfterSeconds": 30 }]
    },
    "app/api/internal/queue/outbox-dispatch/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "outbox-dispatch", "retryAfterSeconds": 30 }]
    }
  }
}
